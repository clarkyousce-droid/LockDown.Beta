rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function validRoom(data) {
      return data.keys().hasAll(['name', 'maxDevices', 'timerMinutes', 'joinCode', 'ownerId', 'members'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 50
        && data.maxDevices is int && data.maxDevices >= 1 && data.maxDevices <= 100
        && data.timerMinutes is int && data.timerMinutes >= 1 && data.timerMinutes <= 10080
        && data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 12
        && data.ownerId is string
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 100
        && data.members.size() <= data.maxDevices;
    }

    // Shared session (so every member sees the same countdown):
    // rooms/{roomId}.sessionActive (bool) + sessionEndsAt (int millis or timestamp, nullable).
    // Optional for backwards-compat with old room docs.
    function validSession(data) {
      return (!('sessionActive' in data) || data.sessionActive is bool)
        && (!('sessionEndsAt' in data)
          || data.sessionEndsAt == null
          || data.sessionEndsAt is int
          || data.sessionEndsAt is timestamp);
    }

    // Members joining/leaving/being kicked must not tamper the session.
    function sessionUnchanged() {
      return resource.data.get('sessionActive', false) == request.resource.data.get('sessionActive', false)
        && resource.data.get('sessionEndsAt', 0) == request.resource.data.get('sessionEndsAt', 0);
    }

    // Shared rooms: rooms/{roomId} =
    //   {name, maxDevices, timerMinutes, joinCode, ownerId, members:[uid]}
    match /rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && validRoom(request.resource.data)
        && validSession(request.resource.data);

      // Owner full edit, member join (add self only),
      // member leave (remove self only), owner kick.
      // Session fields (sessionActive/sessionEndsAt) are owner-only:
      // join/leave/kick branches require sessionUnchanged().
      allow update: if isSignedIn() && (
        // 1. Owner edit (incl. start/stop shared session): owner stays same, data stays valid.
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && validRoom(request.resource.data)
          && validSession(request.resource.data)
        )
        // 2. Join: nothing changes except adding self.
        // Enforces maxDevices server-side (client check alone can be bypassed).
        || (
          request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.maxDevices == resource.data.maxDevices
          && request.resource.data.timerMinutes == resource.data.timerMinutes
          && request.resource.data.joinCode == resource.data.joinCode
          && sessionUnchanged()
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && resource.data.members.size() < resource.data.maxDevices
          && request.resource.data.members.size() <= resource.data.maxDevices
        )
        // 3. Leave: nothing changes except removing self.
        || (
          request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.maxDevices == resource.data.maxDevices
          && request.resource.data.timerMinutes == resource.data.timerMinutes
          && request.resource.data.joinCode == resource.data.joinCode
          && sessionUnchanged()
          && resource.data.members.hasAll(request.resource.data.members)
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.size() == request.resource.data.members.size() + 1
        )
        // 4. Owner kick: owner removes someone else.
        || (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.maxDevices == resource.data.maxDevices
          && request.resource.data.timerMinutes == resource.data.timerMinutes
          && request.resource.data.joinCode == resource.data.joinCode
          && sessionUnchanged()
          && resource.data.members.hasAll(request.resource.data.members)
          && resource.data.members.size() == request.resource.data.members.size() + 1
        )
      );

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // User profiles: users/{uid} = {email, displayName, createdAt, lastLoginAt, isOnline, lastSeen, themeName}
    // Any signed-in user can read (needed to show room members).
    // Only the owner can write.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['email', 'displayName', 'createdAt', 'lastLoginAt', 'isOnline', 'lastSeen', 'themeName'])
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 30))
        && (!('email' in request.resource.data)
          || request.resource.data.email is string)
        && (!('isOnline' in request.resource.data)
          || request.resource.data.isOnline is bool)
        && (!('themeName' in request.resource.data)
          || (request.resource.data.themeName is string
            && request.resource.data.themeName in ['Cyber Slate', 'Neon Lime', 'Royal Violet', 'Sunset Amber']));
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Legacy per-user subcollections.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
